{
  "name": "smart-home",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-Platform Smart Home IoT Monitoring & Control System with Multi-Sensor Anomaly Detection",
  "main": "server.js",
  "workspaces": [
    "backend",
    "client"
  ],
  "scripts": {
    "start": "node server.js",
    "build": "npm run build --workspace=backend && npm run build --workspace=client",
    "build:backend": "npm run build --workspace=backend",
    "build:client": "npm run build --workspace=client",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:client": "npm run dev --workspace=client",
    "test:backend": "npm run test --workspace=backend",
    "test:client": "npm run test --workspace=client",
    "test": "npm run test:backend && npm run test:client"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "smart-home",
    "iot",
    "telemetry",
    "anomaly-detection",
    "fire-alert",
    "security-intruder",
    "energy-conservation",
    "cross-platform",
    "pwa",
    "react",
    "typescript"
  ],
  "author": "m-a-y-a-n-k",
  "license": "ISC"
}
